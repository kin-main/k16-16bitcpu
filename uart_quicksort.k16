; k16 UART quicksort
;
; Input : decimal unsigned 16-bit values in parentheses, comma separated.
;         Example: (5,1,4,1,3)
; Output: the sorted list followed by CR/LF.
;
; Register contract:
;   r8  = element count
;   r9  = call stack pointer
;   r10 = UART MMIO base (0xFF00)
;   r11 = array base (0x0100)
;   r12 = link register (saved by quicksort/print_dec when needed)
;   r13 = memory upper byte; kept at zero for array and digit stores

.org 0x0000

main:
    ; r10 = 0xFF00
    NAND    r10, r0, r0
    SUBI    r10, 255

    ; r11 = 0x0100
    LI      r11, 1
    ADD     r11, r11
    ADD     r11, r11
    ADD     r11, r11
    ADD     r11, r11
    ADD     r11, r11
    ADD     r11, r11
    ADD     r11, r11
    ADD     r11, r11

    ; r9 = 0x0300
    LI      r9, 3
    ADD     r9, r9
    ADD     r9, r9
    ADD     r9, r9
    ADD     r9, r9
    ADD     r9, r9
    ADD     r9, r9
    ADD     r9, r9

restart:
    LI      r8, 0
    LI      r1, 62
    CALL    uart_tx

wait_open:
    CALL    uart_rx
    CALL    uart_tx
    CMPI    r1, 40
    JMP.ne  wait_open
    LI      r7, 0

parse:
    CALL    uart_rx
    CALL    uart_tx

    ; Ignore everything except digits and delimiters.
    CMPI    r1, 48
    JMP.nc  digit_upper
    JMP     delimiter

digit_upper:
    CMPI    r1, 58
    JMP.nc  delimiter

    ; value = value * 10 + (character - '0')
    SUBI    r1, 48
    MOV     r2, r7
    ADD     r2, r2
    ADD     r7, r7
    ADD     r7, r7
    ADD     r7, r7
    ADD     r7, r2
    ADD     r7, r1
    JMP     parse

delimiter:
    CMPI    r1, 44
    JMP.eq  store_value
    CMPI    r1, 41
    JMP.eq  finish_input
    JMP     parse

store_value:
    ADD     r3, r11, r8
    LI      r13, 0
    ST      r7, [r3 + 0]
    ADDI    r8, 1
    LI      r7, 0
    JMP     parse

finish_input:
    ADD     r3, r11, r8
    LI      r13, 0
    ST      r7, [r3 + 0]
    ADDI    r8, 1

    CMPI    r8, 2
    JMP.cs  print_result

    LI      r4, 0
    MOV     r5, r8
    SUBI    r5, 1
    CALL    sort_array

print_result:
    LI      r1, 40
    CALL    uart_tx
    LI      r6, 0

print_loop:
    CMP     r6, r8
    JMP.nc  print_done
    CMPI    r6, 0
    JMP.eq  print_number
    LI      r1, 44
    CALL    uart_tx

print_number:
    ADD     r3, r11, r6
    LD      r1, [r3 + 0]
    NOP
    NOP
    CALL    print_dec
    ADDI    r6, 1
    JMP     print_loop

print_done:
    LI      r1, 41
    CALL    uart_tx
    LI      r1, 13
    CALL    uart_tx
    LI      r1, 10
    CALL    uart_tx
    JMP     restart


; sort_array: iterative quicksort, ascending unsigned 16-bit values.
sort_array:
    ST      r12, [r9 + 0]
    ADDI    r9, 1
    LI      r12, 1
    LI      r4, 0
    ST      r4, [r9 + 0]
    MOV     r5, r8
    SUBI    r5, 1
    ST      r5, [r9 + 1]
    ADDI    r9, 2

sort_pop_range:
    CMPI    r12, 0
    JMP.eq  sort_done
    SUBI    r12, 1
    SUBI    r9, 2
    LD      r4, [r9 + 0]
    NOP
    LD      r5, [r9 + 1]
    NOP
    CMP     r4, r5
    JMP.nc  sort_pop_range

    MOV     r1, r4
    ADD     r1, r5
    SHR     r1
    ADD     r1, r11, r1
    LD      r7, [r1 + 0]
    NOP
    NOP
    LI      r13, 0
    ST      r7, [r9 + 2]
    MOV     r2, r4
    MOV     r3, r5

sort_scan_left:
    ADD     r1, r11, r2
    LD      r6, [r1 + 0]
    NOP
    NOP
    LD      r7, [r9 + 2]
    NOP
    CMP     r6, r7
    JMP.cs  sort_inc_left
    JMP     sort_scan_right

sort_inc_left:
    ADDI    r2, 1
    JMP     sort_scan_left

sort_scan_right:
    ADD     r1, r11, r3
    LD      r6, [r1 + 0]
    NOP
    NOP
    LD      r7, [r9 + 2]
    NOP
    CMP     r7, r6
    JMP.cs  sort_dec_right
    JMP     sort_check_partition

sort_dec_right:
    SUBI    r3, 1
    JMP     sort_scan_right

sort_check_partition:
    CMP     r3, r2
    JMP.cs  sort_push_ranges

    ADD     r1, r11, r2
    LD      r6, [r1 + 0]
    NOP
    NOP
    ADD     r1, r11, r3
    LD      r7, [r1 + 0]
    NOP
    NOP
    LI      r13, 0
    ADD     r1, r11, r2
    ST      r7, [r1 + 0]
    ADD     r1, r11, r3
    ST      r6, [r1 + 0]
    ADDI    r2, 1
    SUBI    r3, 1
    JMP     sort_scan_left

sort_push_ranges:
    CMP     r4, r3
    JMP.nc  sort_skip_left
    ST      r4, [r9 + 0]
    ST      r3, [r9 + 1]
    ADDI    r9, 2
    ADDI    r12, 1

sort_skip_left:
    CMP     r2, r5
    JMP.nc  sort_pop_range
    ST      r2, [r9 + 0]
    ST      r5, [r9 + 1]
    ADDI    r9, 2
    ADDI    r12, 1
    JMP     sort_pop_range

sort_done:
    SUBI    r9, 1
    LD      r12, [r9 + 0]
    NOP
    RET


; print_dec(r1): print an unsigned 16-bit value in decimal.
print_dec:
    ST      r12, [r9 + 0]
    ADDI    r9, 1
    CMPI    r1, 0
    JMP.ne  decimal_digits
    LI      r1, 48
    CALL    uart_tx
    JMP     decimal_return

decimal_digits:
    LI      r13, 0
    LI      r4, 0

divide_by_10:
    CMPI    r1, 0
    JMP.eq  emit_digits
    LI      r2, 0

subtract_10:
    CMPI    r1, 10
    JMP.cs  remainder_ready
    SUBI    r1, 10
    ADDI    r2, 1
    JMP     subtract_10

remainder_ready:
    ADDI    r1, 48
    ST      r1, [r9 + 0]
    ADDI    r9, 1
    ADDI    r4, 1
    MOV     r1, r2
    JMP     divide_by_10

emit_digits:
    CMPI    r4, 0
    JMP.eq  decimal_return
    SUBI    r9, 1
    LD      r1, [r9 + 0]
    NOP
    CALL    uart_tx
    SUBI    r4, 1
    JMP     emit_digits

decimal_return:
    SUBI    r9, 1
    LD      r12, [r9 + 0]
    NOP
    RET


; uart_rx(): wait for rx_ready and return UART_DATA in r1.
uart_rx:
rx_poll:
    LD      r1, [r10 + 1]
    NOP
    TESTI   r1, 2
    JMP.eq  rx_poll
    LD      r1, [r10 + 0]
    NOP
    ANDI    r1, 255
    RET


; uart_tx(r1): wait until tx_busy is clear and send the low byte of r1.
uart_tx:
tx_poll:
    LD      r2, [r10 + 1]
    NOP
    TESTI   r2, 1
    JMP.ne  tx_poll
    ST      r1, [r10 + 0]
    RET
