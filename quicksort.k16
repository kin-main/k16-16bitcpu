;==============================================================================
; k16 CPU: 対話式 UART 入力 -> クイックソート -> UART 出力プログラム
; 
; 入力例: (1,4,5,1,4) などの 16bit整数 (0〜65535) カンマ区切りリスト
; 動作:
;   1. '>' プロンプトを表示し、'(' を検出するまで受信待機
;   2. 10進数文字 ('0'〜'9') をパースして 16bit 値を作成
;   3. ',' で1要素確定し、配列バッファ (RAM) に順次格納
;   4. ')' でリスト終了を検知
;   5. 配列バッファをクイックソート (昇順) で整列
;   6. '(' から始まり、ソート後の要素をカンマ区切り10進数で UART 出力し、')\r\n' で完了
;
; 【本プログラムにおける各レジスタの役割（レジスタマップ）】
;   r0  : ゼロレジスタ（常に0x0000。比較・破棄用）
;   r1  : UART送受信データ / 汎用一時レジスタ（文字コード、10進数値、引数・戻り値）
;   r2  : パース・除算一時変数 / quicksort 内の左インデックス i
;   r3  : メモリアドレス計算ポインタ / quicksort 内の右インデックス j
;   r4  : quicksort 引数: left インデックス
;   r5  : quicksort 引数: right インデックス
;   r6  : 結果出力ループの現在のインデックス (0 〜 r8-1)
;   r7  : パース中の10進数値アキュムレータ / quicksort のピボット値 (pivot)
;   r8  : 受信したリストの要素数 (count)
;   r9  : コールスタックポインタ (初期値: 0x0300)
;   r10 : MMIO 基底アドレス (0xFF00: UART_DATA=0xFF00, UART_STATUS=0xFF01)
;   r11 : 配列バッファ先頭アドレス (0x0100)
;   r12 : サブルーチン戻り先アドレス (リンクレジスタ: CALL命令で自動退避)
;   r13 : quicksort スワップ時アドレス計算 / print_dec 桁数カウンタ
;   r14 : フラグレジスタ (読出: {13'b0, N, C, Z} / quicksort スワップ時一時退避)
;   r15 : プログラムカウンタ (PC)
;==============================================================================

.org 0x0000


main:
    ; 1. 定数・ベースアドレスの初期化
    ; r10 = 0xFFFF (NAND r0, r0)
    NAND    r10, r0, r0
    ; r10 = 0xFF00 (MMIO基底: UART_DATA=0xFF00, UART_STATUS=0xFF01)
    SUBI    r10, 255

    ; r11 = 0x0100 (データ配列バッファ先頭アドレス: max 256要素)
    LI      r11, 1
    ADD     r11, r11    ; << 1
    ADD     r11, r11    ; << 2
    ADD     r11, r11    ; << 3
    ADD     r11, r11    ; << 4
    ADD     r11, r11    ; << 5
    ADD     r11, r11    ; << 6
    ADD     r11, r11    ; << 7
    ADD     r11, r11    ; << 8 -> r11 = 0x0100

    ; r9 = スタックポインタ (0x0300)
    LI      r9, 3
    ADD     r9, r9
    ADD     r9, r9
    ADD     r9, r9
    ADD     r9, r9
    ADD     r9, r9
    ADD     r9, r9
    ADD     r9, r9
    ADD     r9, r9      ; r9 = 0x0300

    ; 起動メッセージ: "QuickSort k16\r\nInput: "
    LI      r1, 81      ; 'Q'
    CALL    uart_tx
    LI      r1, 83      ; 'S'
    CALL    uart_tx
    LI      r1, 32      ; ' '
    CALL    uart_tx
    LI      r1, 107     ; 'k'
    CALL    uart_tx
    LI      r1, 49      ; '1'
    CALL    uart_tx
    LI      r1, 54      ; '6'
    CALL    uart_tx
    LI      r1, 13      ; '\r'
    CALL    uart_tx
    LI      r1, 10      ; '\n'
    CALL    uart_tx
    LI      r1, 73      ; 'I'
    CALL    uart_tx
    LI      r1, 110     ; 'n'
    CALL    uart_tx
    LI      r1, 112     ; 'p'
    CALL    uart_tx
    LI      r1, 117     ; 'u'
    CALL    uart_tx
    LI      r1, 116     ; 't'
    CALL    uart_tx
    LI      r1, 58      ; ':'
    CALL    uart_tx
    LI      r1, 32      ; ' '
    CALL    uart_tx

restart:
    ; 要素数カウンタ r8 = 0
    LI      r8, 0

    ; 対話入力用プロンプト
    LI      r1, 62      ; '>'
    CALL    uart_tx

wait_open_paren:
    ; '(' (ASCII 0x28 = 40) を待つ
    CALL    uart_rx
    CALL    uart_tx      ; 受信文字を端末へエコー
    CMPI    r1, 40
    JMP.ne  wait_open_paren

    ; '(' を受信した直後。数値バッファ r7 = 0
    LI      r7, 0

parse_loop:
    CALL    uart_rx
    CALL    uart_tx      ; 受信文字を端末へエコー

    ; '0' (48) 〜 '9' (57) の判定
    CMPI    r1, 48
    JMP.cs  check_digit_upper
    JMP     check_delimiter

check_digit_upper:
    CMPI    r1, 58
    JMP.cs  check_delimiter

    ; 数字文字: r7 = r7 * 10 + (r1 - 48)
    ; r7 * 10 = (r7 << 3) + (r7 << 1)
    SUBI    r1, 48      ; r1 = 1桁の数値 (0〜9)
    MOV     r2, r7      ; r2 = r7
    ADD     r2, r2      ; r2 = r7 * 2
    ADD     r7, r7      ; *2
    ADD     r7, r7      ; *4
    ADD     r7, r7      ; *8
    ADD     r7, r2      ; r7 = r7 * 10
    ADD     r7, r1      ; r7 = r7 * 10 + digit
    JMP     parse_loop

check_delimiter:
    ; ',' (44) なら要素を配列へ格納
    CMPI    r1, 44
    JMP.eq  store_element

    ; ')' (41) なら最後の要素を格納してソートへ
    CMPI    r1, 41
    JMP.eq  finish_input

    ; それ以外の文字（スペース等）は無視して次へ
    JMP     parse_loop

store_element:
    ; mem[r11 + r8] = r7
    ADD     r3, r11, r8
    ST      r7, [r3 + 0]
    ADDI    r8, 1       ; 要素数 + 1
    LI      r7, 0       ; 次の数値用にクリア
    JMP     parse_loop

finish_input:
    ; 最後の要素を格納
    ADD     r3, r11, r8
    ST      r7, [r3 + 0]
    ADDI    r8, 1       ; 要素数確定
    ; 要素数を退避（r6はクイックソートで使用しない）
    MOV     r6, r8

    ; 要素数が 1 以下の場合はソート不要
    CMPI    r8, 2
    JMP.nc  print_result

    ; クイックソート呼び出し: quicksort(left=0, right=r8-1)
    LI      r4, 0       ; left = 0
    MOV     r5, r8
    SUBI    r5, 1       ; right = r8 - 1
    CALL    quicksort

print_result:
    ; クイックソート後の要素数を復元
    MOV     r8, r6
    ; 結果を '(' + 要素... + ')\r\n' で出力
    LI      r1, 40      ; '('
    CALL    uart_tx

    LI      r6, 0       ; 出力インデックス r6 = 0
print_loop:
    CMP     r6, r8
    JMP.cs  print_done

    ; カンマ出力判定 (r6 > 0 なら先に ',' を出力)
    CMPI    r6, 0
    JMP.eq  print_num_val
    LI      r1, 44      ; ','
    CALL    uart_tx

print_num_val:
    ADD     r3, r11, r6
    LD      r1, [r3 + 0]
    CALL    print_dec   ; r1 の10進数を出力

    ADDI    r6, 1
    JMP     print_loop

print_done:
    LI      r1, 41      ; ')'
    CALL    uart_tx
    LI      r1, 13      ; '\r'
    CALL    uart_tx
    LI      r1, 10      ; '\n'
    CALL    uart_tx

    ; 再度次の入力を待機
    JMP     restart


;==============================================================================
; サブルーチン: quicksort
; 引数:
;   r4 : left インデックス
;   r5 : right インデックス
; スタック (r9) を使用して再帰実行
;==============================================================================
quicksort:
    ; if (left >= right) return;
    CMP     r4, r5
    RET.cs

    ; スタックへ保存: r12 (戻り先), r4 (left), r5 (right)
    ST      r12, [r9 + 0]
    ST      r4,  [r9 + 1]
    ST      r5,  [r9 + 2]
    ADDI    r9,  3

    ; ピボットの決定: mid = (left + right) >> 1
    MOV     r1, r4
    ADD     r1, r5
    SHR     r1          ; r1 = pivot index
    ADD     r3, r11, r1
    LD      r7, [r3 + 0]; r7 = pivot value

    MOV     r2, r4      ; i = left
    MOV     r3, r5      ; j = right

partition_loop:
    ; while (array[i] < pivot) i++
while_i:
    ADD     r1, r11, r2
    LD      r1, [r1 + 0]
    CMP     r1, r7
    JMP.cs  while_j
    ADDI    r2, 1
    JMP     while_i

    ; while (array[j] > pivot) j--
while_j:
    ADD     r1, r11, r3
    LD      r1, [r1 + 0]
    CMP     r7, r1
    JMP.cs  check_swap
    SUBI    r3, 1
    JMP     while_j

check_swap:
    ; if (i <= j) { swap(array[i], array[j]); i++; j--; }
    CMP     r3, r2      ; j - i (i <= j は j >= i つまり Carry set)
    JMP.nc  partition_step_done

    ; swap
    ADD     r1, r11, r2
    LD      r12, [r1 + 0]   ; temp1 = array[i]
    ADD     r13, r11, r3
    LD      r13, [r13 + 0]  ; temp2 = array[j]
    ST      r13, [r1 + 0]   ; array[i] = temp2
    ST      r12, [r13 + 0]  ; array[j] = temp1

    ADDI    r2, 1       ; i++
    SUBI    r3, 1       ; j--

partition_step_done:
    ; if (i <= j) goto partition_loop
    CMP     r3, r2
    JMP.cs  partition_loop

    ; スタックから復元して左側ソート: quicksort(left, j)
    ; 現在: r2 = i, r3 = j
    ; スタックトップ: [r9-3]=r12, [r9-2]=left, [r9-1]=right
    LD      r4, [r9 - 2] ; r4 = left
    MOV     r5, r3       ; r5 = j
    ; 一時的に i (r2) をスタック空き領域へ退避
    ST      r2, [r9 + 0]
    CALL    quicksort

    ; 右側ソート: quicksort(i, right)
    LD      r2, [r9 + 0] ; r2 = i 復元
    LD      r5, [r9 - 1] ; r5 = right
    MOV     r4, r2       ; r4 = i
    CALL    quicksort

    ; スタックからフレーム復元してリターン
    SUBI    r9, 3
    LD      r12, [r9 + 0]
    RET


;==============================================================================
; サブルーチン: print_dec
; 引数: r1 = 出力する16bit正整数
; 動作: 10進数文字列に変換して UART へ順次送信
;==============================================================================
print_dec:
    ST      r12, [r9 + 0]
    ADDI    r9, 1

    ; 0 の場合の特例
    CMPI    r1, 0
    JMP.ne  print_dec_start
    LI      r1, 48      ; '0'
    CALL    uart_tx
    JMP     print_dec_ret

print_dec_start:
    ; 各桁をスタックに積んで逆順に取り出す
    ; カウンタ r13 = 0
    LI      r13, 0

dec_div_loop:
    CMPI    r1, 0
    JMP.eq  dec_print_digits

    ; 16bit除算: r1 / 10 -> 商 r2, 余り r1
    ; 減算ループ方式（k16にDIV命令はないため）
    LI      r2, 0       ; 商 = 0
div10_sub:
    CMPI    r1, 10
    JMP.nc  div10_done
    SUBI    r1, 10
    ADDI    r2, 1
    JMP     div10_sub
div10_done:
    ; 余り r1 (0〜9) を文字コードにしてスタックへ
    ADDI    r1, 48
    ST      r1, [r9 + 0]
    ADDI    r9, 1
    ADDI    r13, 1

    MOV     r1, r2      ; 次のループ用に商をセット
    JMP     dec_div_loop

dec_print_digits:
    CMPI    r13, 0
    JMP.eq  print_dec_ret
    SUBI    r9, 1
    LD      r1, [r9 + 0]
    CALL    uart_tx
    SUBI    r13, 1
    JMP     dec_print_digits

print_dec_ret:
    SUBI    r9, 1
    LD      r12, [r9 + 0]
    RET


;==============================================================================
; サブルーチン: uart_rx
; 戻り値: r1 = 受信した8bitデータ
; ポーリング: 0xFF01 (rx_ready) を監視し、1 になったら 0xFF00 から読み出し
;==============================================================================
uart_rx:
poll_rx:
    LD      r1, [r10 + 1]   ; read 0xFF01 (UART_STATUS)
    TESTI   r1, 2           ; bit 1: rx_ready
    JMP.eq  poll_rx         ; 0 なら待機ループ
    LD      r1, [r10 + 0]   ; read 0xFF00 (UART_DATA) & rx_readyクリア
    ANDI    r1, 255         ; 8bitマスク
    RET


;==============================================================================
; サブルーチン: uart_tx
; 引数: r1 = 送信する8bitデータ
; ポーリング: 0xFF01 (tx_busy) を監視し、0 になったら 0xFF00 へ書き込み
;==============================================================================
uart_tx:
poll_tx:
    LD      r2, [r10 + 1]   ; read 0xFF01 (UART_STATUS)
    TESTI   r2, 1           ; bit 0: tx_busy
    JMP.ne  poll_tx         ; 1 (送信中) なら待機ループ
    ST      r1, [r10 + 0]   ; write 0xFF00 (UART_DATA) -> 送信開始
    RET
